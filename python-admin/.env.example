# NetaTrack India — Python Admin Config
# Copy to .env and fill in your values

# Your site's base URL (no trailing slash)
API_BASE_URL=https://yoursite.com

# API key — generate in Admin Panel > Settings > API Keys
API_KEY=your_api_key_here

# Gemini AI (for auto-scoring leaders)
GEMINI_API_KEY=your_gemini_key

# Optional: Sarvam AI (for Hindi/regional language processing)
SARVAM_API_KEY=your_sarvam_key
