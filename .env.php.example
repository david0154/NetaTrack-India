# NetaTrack India - PHP Environment Variables
# Copy to .env and fill in values

# App
APP_NAME="NetaTrack India"
APP_URL=http://localhost
APP_DEBUG=false
APP_SECRET=change_this_to_a_random_64_character_string_for_production

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=netatrack
DB_USER=netatrack_user
DB_PASS=your_strong_password

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# AI APIs
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
SARVAM_API_KEY=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@netatrack.in

# Cloudflare
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
