# NetaTrack India — Environment Variables
# Copy this file to .env.local and fill in your values

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=netatrack
DB_USER=root
DB_PASS=your_password_here

# Auth
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars

# AI APIs
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
SARVAM_API_KEY=

# Python Thinker App webhook (optional)
PYTHON_SCRAPER_WEBHOOK=http://localhost:8765/trigger
SCRAPER_API_KEY=change_this_to_secure_key

# SMTP (optional, for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@netatrack.in

# Cloudflare (optional)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Next.js
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
