# NetaTrack India - Environment Variables
# Copy this file to .env and fill in your values

# ── Application ──────────────────────────────────────────────────────────
APP_NAME="NetaTrack India"
APP_ENV=production
APP_URL=https://your-domain.com
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_APP_NAME="NetaTrack India"

# ── Database (MySQL) ─────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=netatrack_india
DB_USER=netatrack_user
DB_PASS=your_strong_password_here

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_64_char_random_string_for_production
NEXTAUTH_SECRET=change_this_to_another_64_char_random_string
JWT_EXPIRY_HOURS=24

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── AI Providers (fill at least one) ─────────────────────────────────────
AI_PRIMARY_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-pro
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=anthropic/claude-3-haiku
SARVAM_API_KEY=your_sarvam_key
SARVAM_LANGUAGE=hi-IN

# ── AWS Bedrock (optional) ────────────────────────────────────────────────
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-south-1

# ── SMTP ─────────────────────────────────────────────────────────────────
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_NAME="NetaTrack India"
MAIL_FROM_EMAIL=noreply@your-domain.com

# ── Cloudflare ────────────────────────────────────────────────────────────
CF_ZONE_ID=
CF_API_TOKEN=

# ── Analytics ────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL=

# ── Rate Limiting ────────────────────────────────────────────────────────
RATE_LIMIT_API=60
RATE_LIMIT_SUBMIT=5
RATE_LIMIT_LOGIN=10

# ── Upload ───────────────────────────────────────────────────────────────
UPLOAD_PATH=/var/www/netatrack/public/uploads
MAX_UPLOAD_MB=50

# ── CORS ─────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://your-domain.com
