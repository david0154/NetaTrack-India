# NetaTrack India — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# App
APP_NAME="NetaTrack India"
APP_URL=http://localhost:3000
APP_ENV=production
APP_DEBUG=false
APP_SECRET=your-32-char-minimum-secret-key
JWT_SECRET=your-jwt-secret-key-32-chars-min
JWT_EXPIRY_HOURS=24

# Database (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=netatrack
DB_USER=netatrack_user
DB_PASS=strong_password_here

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=

# AI — Google Gemini (primary)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# AI — OpenAI (fallback)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# AI — OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=google/gemma-3-27b-it:free

# AI — Sarvam (Indian languages)
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_MODEL=sarvam-2b-v0.5

# AWS Bedrock (optional)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_AI_ENDPOINT=
AWS_MODEL_ID=

# Uploads
UPLOAD_PATH=./storage/uploads
UPLOAD_MAX_MB=20

# Rate Limiting
RATE_LIMIT_SUB=5
RATE_LIMIT_API=100

# AI Confidence
AI_MIN_CONFIDENCE=75
AI_AUTO_APPROVE=92

# Cloudflare
CF_ZONE_ID=
CF_API_KEY=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@netatrack.in

# Next.js Public
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="NetaTrack India"
